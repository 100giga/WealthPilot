# Copy to .env and fill in only the provider(s) you actually want to use.
# Nothing in this project requires any of these to be set — the default
# provider is a deterministic mock so every test and demo runs offline.

LLM_PROVIDER=mock          # mock | openai | anthropic | groq
LLM_MODEL=gpt-4o-mini

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional: LangFuse tracing (Milestone 7 / production hardening).
# Tracing silently no-ops if these are left blank.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
